# ============================================================
# FlexiRide .gitignore
# ============================================================

# User-uploaded runtime files — never commit these
/uploads/
/images/*.jpg
/images/*.jpeg
/images/*.png
/images/*.gif
/images/*.webp
!images/logo*.png
!images/logo*.jpg
!images/2logo.*

# Environment secrets
.env

# PHP / Composer
/vendor/
composer.phar

# IDE and OS files
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
