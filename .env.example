# ============================================================
# FlexiRide Environment Variables Config
# Copy this file to .env locally or paste these keys into Railway Environment Variables
# ============================================================

# Database Configuration (Railway automatically sets MYSQLHOST, MYSQLUSER, etc.)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=flexiride

# Admin Credentials
ADMIN_EMAIL=admin@flexiride.com
ADMIN_PASS=Admin@123

# Email Configuration (for OTP and Emergency Alerts)
BREVO_API_KEY=your_brevo_api_key_here
RESEND_API_KEY=your_resend_api_key_here
SENDER_EMAIL=flexiride247@gmail.com
